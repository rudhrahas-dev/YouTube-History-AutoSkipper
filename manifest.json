{
  "manifest_version": 3,
  "name": "YouTube History & Auto-Skipper",
  "version": "2.0",
  "description": "Opens YouTube History with Ctrl+Shift+H and automatically fast-forwards/skips pre-roll and mid-roll ads",
  "permissions": [
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "open-yt-history": {
      "suggested_key": {
        "default": "Ctrl+Shift+H",
        "mac": "Command+Shift+H"
      },
      "description": "Open YouTube History"
    }
  }
}
