{
  "manifest_version": 3,
  "name": "YouTube History & Auto-Skipper",
  "version": "3.0",
  "description": "Opens YouTube History with Ctrl+Shift+H, fast-forwards/skips ads, and enables background/screen-off playback",
  "permissions": [
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "bgplay.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "bgplay.js"
      ],
      "matches": [
        "*://*.youtube.com/*"
      ]
    }
  ],
  "commands": {
    "open-yt-history": {
      "suggested_key": {
        "default": "Ctrl+Shift+H",
        "mac": "Command+Shift+H"
      },
      "description": "Open YouTube History"
    }
  }
}
